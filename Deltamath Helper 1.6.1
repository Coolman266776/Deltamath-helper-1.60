function dimReader(ctx,dims,label){dims=dims||{};if(typeof dims!=='object')throw new AlgebraError('Give the measurements as an object, like { r: 5 }.');const get=(keys,what)=>{const v=pick(dims,keys);return has(v)?readLen(ctx,v,what):null;};const need=(keys,what)=>{const v=get(keys,what);if(!v)throw new AlgebraError('Missing '+what+' of the '+label+'.');return v;};const list=(key,n,what)=>{const v=dims[key];if(!Array.isArray(v))return null;if(v.length!==n)throw new AlgebraError('Give exactly '+n+' '+what+'.');return v.map((x,i)=>readLen(ctx,x,what+' '+(i+1)));};return{get,need,list,raw:dims};}
